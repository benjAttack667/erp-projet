<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.ece.project.controllers.TasksController"
            prefWidth="1400.0" prefHeight="800.0">

    <top>
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #0d0173;">
            <Button fx:id="btnBack" text="← Dashboard" onAction="#goDashboard"/>
            <Label text="Tâches" style="-fx-text-fill: white; -fx-font-size: 18;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <TableView fx:id="tableTasks" prefHeight="400">

            <columns>
                    <TableColumn fx:id="colId" text="ID"/>
                    <TableColumn fx:id="colTitle" text="Titre"/>
                    <TableColumn fx:id="colDescription" text="Description"/>
                    <TableColumn fx:id="colStatus" text="Statut"/>
                    <TableColumn fx:id="colProjectId" text="Projet"/>
                    <TableColumn fx:id="colAssignedTo" text="Assigné à"/>
                </columns>
            </TableView>

            <HBox spacing="10">
                <Button fx:id="btnAdd" text="Ajouter" onAction="#addTask"/>
                <Button fx:id="btnEdit" text="Modifier" onAction="#editTask"/>
                <Button fx:id="btnDelete" text="Supprimer" onAction="#deleteTask"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
