<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.ece.project.controllers.TasksController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #FFFFFF;">

    <!-- ▬▬▬▬▬▬▬▬▬▬▬ TOP BAR ▬▬▬▬▬▬▬▬▬▬▬ -->
    <top>
        <Pane prefHeight="60" style="-fx-background-color: #0d0173;">
            <children>
                <Label text="ECE-ERP"
                       layoutX="20" layoutY="18"
                       textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20"/>
                    </font>
                </Label>

                <HBox spacing="20" layoutX="700" layoutY="18">
                    <children>
                        <Hyperlink text="Dashboard" textFill="WHITE" onAction="#goDashboard"/>
                        <Hyperlink text="Profil" textFill="WHITE" onAction="#goProfil"/>
                        <Hyperlink text="Déconnexion" textFill="WHITE" onAction="#logout"/>
                    </children>
                </HBox>
            </children>
        </Pane>
    </top>


    <!-- ▬▬▬▬▬▬▬▬▬▬▬ SIDE MENU ▬▬▬▬▬▬▬▬▬▬▬ -->
    <left>
        <VBox prefWidth="180" spacing="15" style="-fx-background-color: #F0F0F0; -fx-padding: 20;">
            <children>
                <Label text="Navigation" style="-fx-font-size: 15; -fx-font-weight: bold;"/>

                <Button text="Dashboard"
                        prefWidth="150"
                        style="-fx-background-color: #0d0173; -fx-text-fill: white;"
                        onAction="#goDashboard"/>

                <Button text="Tâches"
                        prefWidth="150"
                        style="-fx-background-color: #0d0173; -fx-text-fill: white;"
                        onAction="#goTasks"/>

                <Button text="Projets"
                        prefWidth="150"
                        style="-fx-background-color: #0d0173; -fx-text-fill: white;"
                        onAction="#goProjets"/>

                <Button text="Profil"
                        prefWidth="150"
                        style="-fx-background-color: #0d0173; -fx-text-fill: white;"
                        onAction="#goProfil"/>

                <Button text="Déconnexion"
                        prefWidth="150"
                        style="-fx-background-color: red; -fx-text-fill: white;"
                        onAction="#logout"/>
            </children>
        </VBox>
    </left>


    <!-- ▬▬▬▬▬▬▬▬▬▬▬ CONTENT PAGE ▬▬▬▬▬▬▬▬▬▬▬ -->
    <center>
        <AnchorPane fx:id="mainContent" style="-fx-padding: 20;">

            <!-- Titre -->
            <Label text="Tâches"
                   layoutX="50" layoutY="20"
                   style="-fx-font-size: 24; -fx-font-weight: bold;"/>

            <!-- Bouton Ajouter une tâche -->
            <Button text="Ajouter une tâche"
                    layoutX="700" layoutY="20"
                    prefWidth="140"
                    style="-fx-background-color: #0d0173; -fx-text-fill: white;"
                    onAction="#onAddTask"/>

            <!-- Tableau des tâches -->
            <TableView fx:id="tableTasks"
                       layoutX="50" layoutY="80"
                       prefHeight="400" prefWidth="750">

                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colNom" text="Nom de la tâche" prefWidth="180"/>
                    <TableColumn fx:id="colProjet" text="Projet associé" prefWidth="150"/>
                    <TableColumn fx:id="colStatus" text="Statut" prefWidth="120"/>
                    <TableColumn fx:id="colDeadline" text="Deadline" prefWidth="150"/>
                </columns>

            </TableView>

        </AnchorPane>
    </center>


    <!-- ▬▬▬▬▬▬▬▬▬▬▬ FOOTER ▬▬▬▬▬▬▬▬▬▬▬ -->
    <bottom>
        <Pane prefHeight="50" style="-fx-background-color: #0d0173;">
            <children>
                <Label text="© 2025 ECE-ERP. Tous droits réservés."
                       layoutX="330" layoutY="17"
                       textFill="WHITE"
                       style="-fx-font-size: 11; -fx-font-weight: bold;"/>
            </children>
        </Pane>
    </bottom>

</BorderPane>
