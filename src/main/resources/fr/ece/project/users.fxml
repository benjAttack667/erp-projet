<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.ece.project.controllers.UsersController"
            style="-fx-background-color: #FFFFFF;"
            prefWidth="1400.0" prefHeight="800.0">

    <!-- ▬▬▬▬▬ TOP BAR ▬▬▬▬▬ -->
    <top>
        <HBox style="-fx-background-color: #0d0173;" prefHeight="60" alignment="CENTER_LEFT" spacing="20">
            <children>
                <Button text="⟵ Retour"
                        onAction="#goBackDashboard"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16;">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                </Button>

                <Label text="ECE-ERP - Gestion des utilisateurs"
                       textFill="WHITE" style="-fx-font-size: 22; -fx-font-weight: bold;">
                    <padding>
                        <Insets top="20" right="0" bottom="0" left="20"/>
                    </padding>
                </Label>
            </children>
        </HBox>
    </top>

    <!-- ▬▬▬▬▬ CONTENT ▬▬▬▬▬ -->
    <center>
        <HBox spacing="30">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- ▬▬▬ TABLEAU RESPONSIVE ▬▬▬ -->
            <TableView fx:id="tableUsers"
                       HBox.hgrow="ALWAYS"
                       prefHeight="500">
                <columns>
                    <TableColumn fx:id="colUserId" text="ID" prefWidth="100"/>
                    <TableColumn fx:id="colUserName" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="colUserSurname" text="Prénom" prefWidth="150"/>
                    <TableColumn fx:id="colUserEmail" text="Email" prefWidth="250"/>
                    <TableColumn fx:id="colUserRole" text="Rôle" prefWidth="130"/>
                </columns>
            </TableView>

            <!-- ▬▬▬ PANNEAU DROITE ▬▬▬ -->
            <VBox spacing="15" alignment="TOP_CENTER" prefWidth="260">

                <Label text="Changer le rôle :" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

                <ComboBox fx:id="cbUserRole" prefWidth="200"/>

                <Button fx:id="btnEditUser" text="Modifier le rôle"
                        prefWidth="200"
                        style="-fx-background-color: #0d0173; -fx-text-fill: white; -fx-font-size: 14;"
                        onAction="#onEditUser"/>

                <Button fx:id="btnDeleteUser" text="Supprimer"
                        prefWidth="200"
                        style="-fx-background-color: #d30000; -fx-text-fill: white; -fx-font-size: 14;"
                        onAction="#onDeleteUser"/>
            </VBox>

        </HBox>
    </center>
</BorderPane>
