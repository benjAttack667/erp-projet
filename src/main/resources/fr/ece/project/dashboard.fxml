<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.ece.project.controllers.DashboardController"
            style="-fx-background-color: #FFFFFF;"
            prefWidth="1400" prefHeight="800">


    <!-- TOP BAR -->
    <top>
        <HBox spacing="10" style="-fx-background-color: #0d0173; -fx-padding: 10;" alignment="CENTER_LEFT">
            <children>
                <Label text="ECE-ERP" textFill="WHITE">
                    <font><Font name="System Bold" size="20"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>
    </top>

    <!-- LEFT MENU -->
    <left>
        <VBox spacing="15" style="-fx-background-color: #F0F0F0; -fx-padding: 20;"
              BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Navigation" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
                <Button fx:id="btnDashboard" text="Dashboard" prefWidth="150"
                        style="-fx-background-color: #0d0173; -fx-text-fill: white;" onAction="#goDashboard"/>
                <Button fx:id="btnTasks" text="Tâches" prefWidth="150"
                        style="-fx-background-color: #0d0173; -fx-text-fill: white;" onAction="#goTasks"/>
                <Button fx:id="btnProjets" text="Projets" prefWidth="150"
                        style="-fx-background-color: #0d0173; -fx-text-fill: white;" onAction="#goProjets"/>
                <Button fx:id="btnProfil" text="Gestion" prefWidth="150"
                        style="-fx-background-color: #0d0173; -fx-text-fill: white;" onAction="#goProfil"/>
                <Button fx:id="btnLogout" text="Déconnexion" prefWidth="150"
                        style="-fx-background-color: red; -fx-text-fill: white;" onAction="#logout"/>
                <Region VBox.vgrow="ALWAYS"/> <!-- permet de pousser les boutons vers le haut -->
            </children>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane style="-fx-padding: 20;" BorderPane.alignment="CENTER">
            <Label text="Bienvenue sur votre Dashboard"
                   style="-fx-font-size: 22; -fx-font-weight: bold;"/>
        </StackPane>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox style="-fx-background-color: #0d0173; -fx-padding: 10;" alignment="CENTER">
            <children>
                <Label text="© 2025 ECE-ERP. Tous droits réservés." textFill="WHITE"
                       style="-fx-font-size: 11; -fx-font-weight: bold;"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
