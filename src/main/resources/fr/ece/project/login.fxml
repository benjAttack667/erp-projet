<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.ece.project.controllers.LoginController"
            style="-fx-background-color: #FFFFFF;"
            prefWidth="1400.0" prefHeight="800.0">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="10" style="-fx-background-color: #0d0173; -fx-padding: 10;" alignment="CENTER_LEFT">
            <children>
                <Label text="ECE-ERP" textFill="WHITE">
                    <font><Font name="System Bold" size="18"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink fx:id="connexionLink" text="Connexion" textFill="WHITE" onAction="#redirectConnexion"/>
                <Hyperlink fx:id="inscriptionLink" text="Inscription" textFill="WHITE" onAction="#redirectInscription"/>
            </children>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 40;">
            <children>

                <Label text="Connexion" textFill="#0d0173">
                    <font><Font size="24"/></font>
                </Label>

                <VBox spacing="15" style="-fx-background-color: #F0F0F0; -fx-padding: 30; -fx-background-radius: 10;" maxWidth="400">
                    <children>
                        <Label text="Email"/>
                        <TextField fx:id="emailField" promptText="Email"/>

                        <Label text="Mot de passe"/>
                        <PasswordField fx:id="passwordField" promptText="Mot de passe"/>

                        <Button text="Connexion" fx:id="button" onAction="#onLogin"
                                style="-fx-background-color: #0d0173; -fx-text-fill: white; -fx-padding: 8 20;"/>
                        <Label fx:id="labelField" textFill="#ff0404"/>
                    </children>
                </VBox>

            </children>
        </VBox>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox style="-fx-background-color: #0d0173; -fx-padding: 10;" alignment="CENTER">
            <children>
                <Label text="© 2025 ECE-ERP. Tous droits réservés." textFill="WHITE"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
