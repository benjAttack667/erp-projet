<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="603.0" prefWidth="653.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.ece.project.controllers.SignInController">
    <children>
        <Pane prefHeight="61.0" prefWidth="683.0" style="-fx-background-color: #0d0173;">
            <children>
                <Label layoutX="16.0" layoutY="20.0" prefHeight="25.0" prefWidth="65.0" text="ECE-ERP" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font></Label>
                <Hyperlink fx:id="connexionLink" layoutX="493.0" layoutY="24.0" onAction="#redirectConnexion" text="Connexion" textFill="WHITE">
                    <font>
                        <Font name="Eras Bold ITC" size="10.0" />
                    </font></Hyperlink>
                <Hyperlink fx:id="inscriptionLink" layoutX="567.0" layoutY="23.0" onAction="#redirectInscription" text="Inscription" textFill="WHITE">
                    <font>
                        <Font name="Eras Bold ITC" size="10.0" />
                    </font>
                </Hyperlink>
            </children></Pane>
        <Pane layoutX="215.0" layoutY="113.0" prefHeight="360.0" prefWidth="254.0" style="-fx-background-color: F0F0F0;">
            <children>
                <TextField fx:id="nameField" layoutX="52.0" layoutY="32.0" />
                <TextField fx:id="surnameField" layoutX="52.0" layoutY="80.0" />

                <TextField fx:id="emailField" layoutX="52.0" layoutY="136.0" />
                <PasswordField fx:id="passwordField" layoutX="52.0" layoutY="189.0" />
                <DatePicker fx:id="datePicker" layoutX="39.0" layoutY="236.0" />
                <Label layoutX="63.0" layoutY="14.0" text="Nom" />
                <Label layoutX="62.0" layoutY="63.0" text="Prénom" />
                <Label layoutX="58.0" layoutY="119.0" text="email" />
                <Label layoutX="58.0" layoutY="172.0" text="Mot de passe" />
                <Label layoutX="44.0" layoutY="219.0" text="Date de Naissance" />
            <Button fx:id="button" layoutX="95.0" layoutY="284.0" mnemonicParsing="false" onAction="#onSignIn" style="-fx-background-color: #0d0173;" text="S'inscrire" textFill="WHITE" />
            <Label fx:id="label" layoutX="112.0" layoutY="329.0" text="text" textFill="RED" />
            </children>
        </Pane>
        <Label layoutX="308.0" layoutY="85.0" text="Inscription" textAlignment="CENTER" textFill="#0d0173">
            <font>
                <Font size="18.0" />
            </font>
        </Label>
        <Pane layoutY="541.0" prefHeight="61.0" prefWidth="683.0" style="-fx-background-color: #0d0173;">
            <children>
                <Label layoutX="241.0" layoutY="22.0" text="© 2025 ECE-ERP. Tous droits réservés." textAlignment="CENTER" textFill="WHITE" />
            </children>
        </Pane>
    </children>
</AnchorPane>
