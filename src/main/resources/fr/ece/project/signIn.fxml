<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.ece.project.controllers.SignInController"
            prefWidth="1400.0" prefHeight="800.0">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="10" style="-fx-background-color: #0d0173; -fx-padding: 10;" alignment="CENTER_LEFT">
            <children>
                <Label text="ECE-ERP" textFill="WHITE">
                    <font><Font name="System Bold" size="18"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink fx:id="connexionLink" text="Connexion" textFill="WHITE" onAction="#redirectConnexion"/>
                <Hyperlink fx:id="inscriptionLink" text="Inscription" textFill="WHITE" onAction="#redirectInscription"/>
            </children>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 40;">
            <children>

                <Label text="Inscription" textFill="#0d0173">
                    <font><Font size="20"/></font>
                </Label>

                <GridPane hgap="15" vgap="15"
                          style="-fx-background-color: #F0F0F0; -fx-padding: 20; -fx-background-radius: 10;"
                          maxWidth="400">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="35"/>
                        <ColumnConstraints percentWidth="65"/>
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints percentHeight="20"/>
                        <RowConstraints percentHeight="20"/>
                        <RowConstraints percentHeight="20"/>
                        <RowConstraints percentHeight="20"/>
                        <RowConstraints percentHeight="20"/>
                    </rowConstraints>

                    <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Prénom :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="surnameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Email :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Mot de passe :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="passwordField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Date de naissance :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="datePicker" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                </GridPane>

                <Button text="S'inscrire"
                        fx:id="button"
                        onAction="#onSignIn"
                        style="-fx-background-color: #0d0173; -fx-text-fill: white; -fx-padding: 8 20;"/>

                <Label fx:id="label" textFill="RED"/>
            </children>
        </VBox>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox style="-fx-background-color: #0d0173; -fx-padding: 10;" alignment="CENTER">
            <children>
                <Label text="© 2025 ECE-ERP. Tous droits réservés." textFill="WHITE"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
