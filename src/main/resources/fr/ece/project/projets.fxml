<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.ece.project.controllers.ProjetsController"
            style="-fx-background-color: #FFFFFF;"
            prefWidth="1400.0" prefHeight="800.0">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="10" style="-fx-background-color: #0d0173; -fx-padding: 10;" alignment="CENTER_LEFT">
            <children>
                <Label text="ECE-ERP" textFill="WHITE">
                    <font><Font name="System Bold" size="20"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>

            </children>
        </HBox>
    </top>

    <!-- SIDE MENU -->
    <left>
        <VBox prefWidth="180" spacing="15" style="-fx-background-color: #F0F0F0; -fx-padding: 20;">
            <children>
                <Label text="Navigation" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
                <Button text="Dashboard" prefWidth="150" style="-fx-background-color: #0d0173; -fx-text-fill: white;" onAction="#goDashboard"/>
                <Button text="Tâches" prefWidth="150" style="-fx-background-color: #0d0173; -fx-text-fill: white;" onAction="#goTasks"/>
                <Button text="Projets" prefWidth="150" style="-fx-background-color: #0d0173; -fx-text-fill: white;" onAction="#goProjets"/>
                <Button fx:id="btnProfil" text="Gestion users" prefWidth="150" style="-fx-background-color: #0d0173; -fx-text-fill: white;" onAction="#goProfil"/>
                <Button text="Déconnexion" prefWidth="150" style="-fx-background-color: red; -fx-text-fill: white;" onAction="#logout"/>
            </children>
        </VBox>
    </left>

    <!-- CONTENT AREA -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <children>
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <Label text="Projets" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox spacing="10">
                        <Label text="Assigner à :" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="cbAssignEmployee" prefWidth="140"/>

                        <Button fx:id="btnAddProjet" text="Ajouter un projet" prefWidth="140"
                                style="-fx-background-color: #0d0173; -fx-text-fill: white;" onAction="#onAddProjet"/>
                        <Button fx:id="btnEditProjet" text="Modifier" prefWidth="140"
                                style="-fx-background-color: #FFA500; -fx-text-fill: white;" onAction="#onEditProjet"/>
                        <Button fx:id="btnDeleteProjet" text="Supprimer" prefWidth="140"
                                style="-fx-background-color: #FF0000; -fx-text-fill: white;" onAction="#onDeleteProjet"/>
                    </VBox>
                </HBox>

                <TableView fx:id="tableProjets" prefHeight="500">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colNom" text="Nom du projet" prefWidth="200"/>
                        <TableColumn fx:id="colDesc" text="Description" prefWidth="280"/>
                        <TableColumn fx:id="colDate" text="Date de création" prefWidth="160"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox style="-fx-background-color: #0d0173; -fx-padding: 10;" alignment="CENTER">
            <children>
                <Label text="© 2025 ECE-ERP. Tous droits réservés." textFill="WHITE"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
